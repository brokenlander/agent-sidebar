#!/usr/bin/env python3
"""agent-conversations — closed claude conversations, listed for agent-reopen.

  agent-conversations list [--all] [--project DIR]   id, cwd, title, display row
  agent-conversations preview ID                     the tail of one conversation
"""
import json
import os
import re
import shutil
import subprocess
import sys
import textwrap
import time
from pathlib import Path

HOME = Path.home()
CFG = Path(os.environ.get("CLAUDE_CONFIG_DIR") or HOME / ".claude")
PROJECTS = CFG / "projects"
HISTORY = CFG / "history.jsonl"
BRIEF = "Session bootstrap"
TITLE_TYPES = ("custom-title", "agent-name", "ai-title")

DIM = "\033[38;2;86;95;137m"
NAME = "\033[38;2;145;180;250m"
YOU = "\033[38;2;125;207;255m"
AGENT = "\033[38;2;187;154;247m"
RESET = "\033[0m"


def slug(path):
    return re.sub(r"[^A-Za-z0-9]", "-", str(path))


def tilde(path):
    h = str(HOME)
    return "~" + path[len(h):] if path == h or path.startswith(h + "/") else path


def age(secs):
    s = max(0, int(secs))
    for unit, n in (("d", 86400), ("h", 3600), ("m", 60)):
        if s >= n:
            return f"{s // n}{unit}"
    return f"{s}s"


def proc_start(pid):
    try:
        stat = Path(f"/proc/{pid}/stat").read_text()
    except OSError:
        return None
    rest = stat[stat.rindex(")") + 2:].split()
    return None if rest[0] == "Z" else rest[19]


def live_ids():
    ids = set()
    for f in (CFG / "sessions").glob("*.json"):
        try:
            o = json.loads(f.read_text())
        except (OSError, ValueError):
            continue
        if o.get("sessionId") and proc_start(o.get("pid")) == str(o.get("procStart")):
            ids.add(o["sessionId"])
    return ids


RG = shutil.which("rg")


def grep(args, files):
    if not files:
        return ""
    base = [RG, "-F", "-a", "--no-heading", "--no-line-number", "--no-config"] if RG else ["grep", "-F"]
    r = subprocess.run([*base, *args, "--", *map(str, files)],
                       capture_output=True, text=True, errors="replace",
                       env={**os.environ, "LC_ALL": "C"})
    return r.stdout


FIELD = {"custom-title": "customTitle", "agent-name": "agentName", "ai-title": "aiTitle"}


def titles(files):
    last = {}
    pats = [a for t in TITLE_TYPES for a in ("-e", f'"type":"{t}"')]
    for line in grep(["-H", *pats], files).splitlines():
        path, _, rec = line.partition(".jsonl:")
        for t in TITLE_TYPES:
            if f'"type":"{t}"' in rec:
                last[(Path(path).name, t)] = rec
    found = {}
    for (sid, t), rec in last.items():
        try:
            o = json.loads(rec)
        except ValueError:
            continue
        v = o.get(FIELD[t]) if o.get("type") == t else None
        if isinstance(v, str) and v.strip():
            found.setdefault(sid, {})[t] = v.strip()
    return found


SID = re.compile(r'"sessionId":"([^"]+)"')


def first_prompts(ids):
    out = {}
    try:
        fh = open(HISTORY, encoding="utf-8", errors="replace")
    except OSError:
        return out
    with fh:
        for line in fh:
            m = SID.search(line)
            if not m or m.group(1) not in ids or m.group(1) in out:
                continue
            try:
                d = " ".join((json.loads(line).get("display") or "").split())
            except ValueError:
                continue
            if d and not d.startswith("/") and not d.startswith(BRIEF):
                out[m.group(1)] = d
    return out


def cwd_of(path):
    try:
        with open(path, "rb") as fh:
            head = fh.read(262144).decode("utf-8", "replace")
    except OSError:
        return ""
    for line in head.splitlines():
        if '"cwd"' not in line:
            continue
        try:
            c = json.loads(line).get("cwd")
        except ValueError:
            continue
        if c:
            return c
    return ""


def sanitize(title, n=60):
    t = re.sub(r"[\x00-\x1f\x7f]", " ", title)
    return " ".join(t.split())[:n]


def conversations(dirs):
    files = [f for d in dirs for f in d.glob("*.jsonl")]
    open_now = live_ids()
    files = [f for f in files if f.stem not in open_now]
    used = {Path(p).stem for p in grep(["-l", '"type":"user"'], files).split("\n") if p}
    files = [f for f in files if f.stem in used]
    named = titles(files)
    prompts = first_prompts({f.stem for f in files})
    rows = []
    for f in files:
        t = named.get(f.stem, {})
        prompt = prompts.get(f.stem, "")
        title = t.get("custom-title") or t.get("agent-name") or prompt or t.get("ai-title")
        if not title:
            continue
        cwd = cwd_of(f)
        if not cwd or not os.path.isdir(cwd):
            continue
        about = prompt if prompt != title else t.get("ai-title", "")
        rows.append((f.stat().st_mtime, f.stem, cwd, sanitize(title), sanitize(about, 200)))
    rows.sort(reverse=True)
    return rows


def cmd_list(argv):
    every = "--all" in argv
    project = os.getcwd()
    if "--project" in argv:
        i = argv.index("--project")
        if i + 1 < len(argv) and argv[i + 1]:
            project = argv[i + 1]
    if every:
        dirs = [d for d in PROJECTS.iterdir() if d.is_dir()]
    else:
        dirs = [PROJECTS / slug(os.path.realpath(project))]
        dirs = [d for d in dirs if d.is_dir()]
    now = time.time()
    for mtime, sid, cwd, title, about in conversations(dirs):
        where = f"{os.path.basename(cwd) or cwd}  " if every else ""
        shown = f"{NAME}{title[:28]:<28}{RESET} {DIM}{age(now - mtime):>4}  {where}{about}{RESET}"
        print(f"{sid}\t{cwd}\t{title}\t{shown}")


def text_of(o):
    c = o.get("message", {}).get("content")
    if isinstance(c, str):
        return c
    if isinstance(c, list):
        return " ".join(b.get("text", "") for b in c
                        if isinstance(b, dict) and b.get("type") == "text")
    return ""


def find(sid):
    for d in PROJECTS.iterdir():
        p = d / f"{sid}.jsonl"
        if p.is_file():
            return p
    return None


def cmd_preview(argv):
    if not argv:
        return
    path = find(argv[0])
    if path is None:
        print("no transcript for that id")
        return
    cols = max(20, int(os.environ.get("FZF_PREVIEW_COLUMNS") or 80) - 1)
    budget = max(6, int(os.environ.get("FZF_PREVIEW_LINES") or 40))
    with open(path, "rb") as fh:
        fh.seek(0, os.SEEK_END)
        start = max(0, fh.tell() - 600000)
        fh.seek(start)
        lines = fh.read().decode("utf-8", "replace").splitlines()[1 if start else 0:]
    said = []
    for line in lines:
        try:
            o = json.loads(line)
        except ValueError:
            continue
        if o.get("type") not in ("user", "assistant") or o.get("isMeta") or o.get("isSidechain"):
            continue
        t = " ".join(text_of(o).split())
        if not t or t.startswith("<") or t.startswith("[Request interrupted") or t.startswith(BRIEF):
            continue
        said.append((o["type"], t))
    where = f"{age(time.time() - path.stat().st_mtime)} ago · {tilde(cwd_of(path))}"
    head = [f"{DIM}{where[:cols]}{RESET}", ""]
    out = []
    for who, t in reversed(said):
        label = f"{YOU}you{RESET}" if who == "user" else f"{AGENT}cyan{RESET}"
        body = textwrap.wrap(t, cols - 2) or [""]
        block = [label] + ["  " + b for b in body] + [""]
        room = budget - len(head) - len(out)
        if room <= 1:
            break
        if len(block) > room:
            block = block[:room - 1] + ["  …"]
        out = block + out
    print("\n".join(head + out))


def main():
    argv = sys.argv[1:]
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return
    {"list": cmd_list, "preview": cmd_preview}.get(argv[0], lambda a: print(__doc__.strip()))(argv[1:])


if __name__ == "__main__":
    try:
        main()
    except BrokenPipeError:
        pass
